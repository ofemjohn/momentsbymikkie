# Required for the /admin invoice dashboard.
# Generate a strong random value for each, e.g.: openssl rand -base64 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Auto-populated by Vercel once a Blob store is connected to this project
# (Vercel dashboard -> Storage -> Create Database -> Blob). Not needed to
# set manually in production; for local dev, run `vercel env pull` after
# connecting the store, or paste the token from the Blob store's ".env.local" tab.
BLOB_READ_WRITE_TOKEN=
