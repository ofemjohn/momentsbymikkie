# Optional overrides for the /admin login credentials — see
# lib/admin-config.ts for the hardcoded defaults these fall back to.
# Only set these if you want to change the password without a redeploy,
# or if this repo is ever made public (then hardcoding is no longer safe).
# Generate a strong random value for each, e.g.: openssl rand -base64 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Required. Auto-populated by Vercel once a Blob store is connected to
# this project (Vercel dashboard -> Storage -> Create Database -> Blob).
# Not something you set manually in production; for local dev, run
# `vercel env pull` after connecting the store, or paste the token from
# the Blob store's ".env.local" tab.
BLOB_READ_WRITE_TOKEN=
